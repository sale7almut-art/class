import { call, text } from 'ionicons/icons';
import { Component , } from '@angular/core';
import {AlertController,ActionSheetController, ToastController, LoadingController,IonHeader, IonToolbar, IonTitle, IonContent, IonItem, IonLabel, IonFooter, IonIcon, IonItemDivider, IonList, IonItemSliding, IonItemOption, IonItemOptions, IonImg, IonAvatar, IonThumbnail, IonSpinner, IonProgressBar, IonRefresher, IonRefresherContent, IonButton } from '@ionic/angular/standalone';
import { CommonModule, NgForOf, NgIf } from '@angular/common';
import { Icon } from 'ionicons/dist/types/components/icon/icon';
@Component({
  selector: 'app-home',
  templateUrl: 'home.page.html',
  styleUrls: ['home.page.scss'],
  imports: [IonButton,  IonItemOptions, IonFooter, IonLabel, IonItem, IonHeader, IonToolbar, IonTitle, IonContent, IonIcon, IonItemDivider, IonList, IonItemSliding, IonItemOption, NgForOf, IonImg, IonAvatar, IonThumbnail, IonSpinner, NgIf, IonProgressBar, IonRefresher, IonRefresherContent],
})
export class HomePage {
 
  constructor(private alertctrl:AlertController
  ) {}
async showCheckbosAlert(){
  let loading=await this.alertctrl.create({

    header:'Checkbox Alert',
    message:'chose your hobbies',
    
    inputs:[
      {
      
      type:'checkbox',
      label:'swimming',
       value:'swim',

       
      },
      {
        type:'checkbox',
        label:'reading',
        value:'read',
      }
    ],
    buttons:[
      {
        text:'Cancel',
        role:'cancel',
      },
      {
        text:'save',
        handler:(data)=>{
          console.log('user logged',data);
          
        }
      }
    ]
  });

  await loading.present();
}
}
